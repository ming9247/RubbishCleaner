<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RubbishCleaner.App</RootNamespace>
    <AssemblyName>RubbishCleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>
    <Product>RubbishCleaner</Product>
    <Description>Windows 流氓软件检测与残留清理工具</Description>
    <Company>RubbishCleaner</Company>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RubbishCleaner.Core\RubbishCleaner.Core.csproj" />
    <ProjectReference Include="..\RubbishCleaner.Common\RubbishCleaner.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 清理/卸载这类"会动用户数据"的动作不给 UI 之外暴露 public 入口，
         但又必须能被单测直接驱动，因此只对测试程序集开放 internal。 -->
    <InternalsVisibleTo Include="RubbishCleaner.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ApplicationIcon 只把图标嵌进 exe 的资源段，WPF 的 Image/Icon 属性取不到它。
      必须同时以 Resource 方式打进程序集，XAML 里的 "/app.ico" 才能解析。
    -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\trust-table.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
