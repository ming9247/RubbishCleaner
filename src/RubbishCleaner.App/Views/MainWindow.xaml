<Window x:Class="RubbishCleaner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RubbishCleaner.App.ViewModels"
        Title="RubbishCleaner — 开机自启动检测"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

  <Window.Resources>
    <!-- 一行软件：风险色块 + 名称 + 启动方式 + 发行商 + 分数，点击展开证据 -->
    <DataTemplate x:Key="SoftwareRowTemplate" DataType="{x:Type vm:SoftwareItemViewModel}">
      <Border x:Name="RowRoot"
              Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,8">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" MinWidth="180" />
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>

            <!-- 风险等级色块 -->
            <Border Grid.Column="0" Style="{StaticResource RiskPill}"
                    Background="{Binding Level, Converter={StaticResource RiskToBrush}}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding LevelText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource SecondaryText}"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding StartupSummary}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StartupSummary}" />

            <StackPanel Grid.Column="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding Publisher}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding RunningText}" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <StackPanel Grid.Column="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding ScoreText}" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="{Binding HitSummary}" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <Border Grid.Column="5" Style="{StaticResource RiskPill}" Background="#EEF2FF" VerticalAlignment="Center">
              <TextBlock Text="{Binding TrustText}" FontSize="11" Foreground="#3730A3" />
            </Border>

            <ToggleButton Grid.Column="6" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          VerticalAlignment="Center" Width="24" Height="24"
                          Content="▾" ToolTip="展开证据明细">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </Grid>

          <!-- 证据链：默认折叠，按需渲染 -->
          <Border Margin="72,6,0,0" Padding="10" Background="#FAFBFC" CornerRadius="6"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="判定依据" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Evidences}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding SeverityText}"
                                 Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                 FontSize="11" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="命中规则" FontWeight="SemiBold" Margin="0,8,0,4" />
              <ItemsControl ItemsSource="{Binding ScoreItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Content="打开所在文件夹" Margin="0,10,0,0" HorizontalAlignment="Left"
                      Padding="10,4"
                      Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <DataTemplate.Triggers>
        <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="RowRoot" Property="Background" Value="#F8FAFF" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部：标题 + 操作 -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="RubbishCleaner" Style="{StaticResource TitleText}" />
          <TextBlock Text="v0.1" Style="{StaticResource SecondaryText}" Margin="8,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="开始扫描" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
          <Button Content="停止" Command="{Binding CancelCommand}" />
          <Button Content="导出报告" Command="{Binding ExportReportCommand}" />
          <Button Content="打开日志" Command="{Binding OpenLogFolderCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 权限提示条 -->
    <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="0,0,0,1" Padding="16,8"
            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                   Text="当前以标准用户权限运行：HKLM、部分服务与计划任务可能读取不完整。建议以管理员身份重新启动。" />
        <Button Grid.Column="1" Content="以管理员身份重启" Command="{Binding RelaunchElevatedCommand}" />
      </Grid>
    </Border>

    <!-- 主体：左侧分组 + 右侧列表 -->
    <Grid Grid.Row="2" Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="196" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧分组与统计 -->
      <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="分类" FontWeight="SemiBold" Margin="0,0,0,8" />
          <Button Content="全部" HorizontalContentAlignment="Left" Command="{Binding ShowAllCommand}" />
          <Button Content="高风险" HorizontalContentAlignment="Left" Command="{Binding ShowHighRiskCommand}" />
          <Button Content="疑似" HorizontalContentAlignment="Left" Command="{Binding ShowSuspiciousCommand}" />
          <Button Content="正常" HorizontalContentAlignment="Left" Command="{Binding ShowNormalCommand}" />

          <Separator Margin="0,12" />

          <TextBlock Text="统计" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="{Binding CountsText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DurationText, StringFormat=耗时：{0}}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding TrustTableInfo, StringFormat=特征库：{0}}" Style="{StaticResource SecondaryText}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- 右侧列表 -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 表头 -->
          <Border Grid.Row="0" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="8,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="34" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="等级" Style="{StaticResource SecondaryText}" />
              <TextBlock Grid.Column="1" Text="程序" Style="{StaticResource SecondaryText}" Margin="8,0" />
              <TextBlock Grid.Column="2" Text="启动方式" Style="{StaticResource SecondaryText}" />
              <TextBlock Grid.Column="3" Text="发行商 / 状态" Style="{StaticResource SecondaryText}" />
              <TextBlock Grid.Column="4" Text="风险分" Style="{StaticResource SecondaryText}" />
              <TextBlock Grid.Column="5" Text="特征库" Style="{StaticResource SecondaryText}" />
            </Grid>
          </Border>

          <!-- 列表：开启虚拟化与容器回收，十万级数据不卡 -->
          <ListBox Grid.Row="1"
                   x:Name="ProfileList"
                   ItemsSource="{Binding FilteredProfiles}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   ItemTemplate="{StaticResource SoftwareRowTemplate}"
                   BorderThickness="0"
                   Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel"
                   VirtualizingPanel.CacheLength="2">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>

          <!-- 空状态 -->
          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="还没有扫描结果" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="点击右上角「开始扫描」，检测开机自启动、无界面常驻程序" Margin="0,6,0,0"
                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- 底部状态栏 -->
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ProgressBar Grid.Column="0" Width="160" Height="6" Minimum="0" Maximum="100"
                     Value="{Binding Progress, Mode=OneWay}" Margin="0,0,12,0"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding StatusText}" />
          <TextBlock Text="{Binding StageText}" Style="{StaticResource SecondaryText}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding ErrorText}" Foreground="#B45309" TextWrapping="Wrap" FontSize="12"
                     Visibility="{Binding ErrorText, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
