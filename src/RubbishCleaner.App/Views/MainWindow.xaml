<Window x:Class="RubbishCleaner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RubbishCleaner.App.ViewModels"
        xmlns:infra="clr-namespace:RubbishCleaner.App.Infrastructure"
        Title="RubbishCleaner — 开机自启动检测与残留清理"
        Height="760" Width="1180"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="/app.ico"
        FontFamily="Microsoft YaHei UI, Segoe UI">

  <Window.Resources>
    <!-- 可点击的排序列头：显示列名 + 当前排序方向箭头 -->
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="0,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 一行软件：图标 + 风险色块 + 名称 + 启动方式 + 发行商 + 分数，点击展开证据 -->
    <DataTemplate x:Key="SoftwareRowTemplate" DataType="{x:Type vm:SoftwareItemViewModel}">
      <Border x:Name="RowRoot"
              Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,7">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="*" MinWidth="150" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="62" />
              <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>

            <!-- 风险等级色块 -->
            <Border Grid.Column="0" Style="{StaticResource RiskPill}"
                    Background="{Binding Level, Converter={StaticResource RiskToBrush}}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding LevelText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <!-- 程序图标 -->
            <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16"
                   VerticalAlignment="Center" Margin="2,0,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="2" Margin="6,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource SecondaryText}"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
            </StackPanel>

            <TextBlock Grid.Column="3" Text="{Binding StartupSummary}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StartupSummary}" />

            <!--
              用 Grid 而不是 StackPanel：StackPanel 不会按列宽裁剪子元素，
              长文本会溢出到相邻列（"发行商压到分数上"，实测踩过）。
              Grid 会约束子元素宽度，配合 TextTrimming 才能真正省略。
            -->
            <Grid Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="{Binding Publisher}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Publisher}" />
              <TextBlock Grid.Row="1" Text="{Binding StateText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                    <Style.Triggers>
                      <!-- 失效启动项用琥珀色强调：这是"该清理"的信号，比"未运行"重要 -->
                      <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                        <Setter Property="Foreground" Value="#B45309" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>

            <StackPanel Grid.Column="5" VerticalAlignment="Center">
              <TextBlock Text="{Binding ScoreText}" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="{Binding HitSummary}" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <Border Grid.Column="6" Style="{StaticResource RiskPill}" Background="#EEF2FF" VerticalAlignment="Center">
              <TextBlock Text="{Binding TrustText}" FontSize="11" Foreground="#3730A3" />
            </Border>

            <ToggleButton Grid.Column="7" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          VerticalAlignment="Center" Width="24" Height="24"
                          Content="▾" ToolTip="展开判定依据">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </Grid>

          <!-- 证据链：默认折叠，按需渲染 -->
          <Border Margin="98,6,0,0" Padding="10" Background="#FAFBFC" CornerRadius="6"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="判定依据" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Evidences}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding SeverityText}"
                                 Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                 FontSize="11" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="命中规则" FontWeight="SemiBold" Margin="0,8,0,4" />
              <ItemsControl ItemsSource="{Binding ScoreItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 需要手动处理的残留：给出可复制的命令，但不代劳 -->
              <StackPanel Visibility="{Binding HasManualFixes, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="需手动处理" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="#B45309" />
                <ItemsControl ItemsSource="{Binding ManualFixes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="1"
                              CornerRadius="4" Padding="8" Margin="0,0,0,6">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                          <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />

                          <!-- 只读文本框：可直接 Ctrl+C 复制，避免用 TextBlock 无法选中的问题 -->
                          <TextBox Text="{Binding Command, Mode=OneWay}" IsReadOnly="True"
                                   Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}"
                                   FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"
                                   Background="White" BorderBrush="#E0C88A" Padding="5,3"
                                   HorizontalScrollBarVisibility="Auto" />

                          <TextBlock Text="{Binding CommandHint}" TextWrapping="Wrap" FontSize="11"
                                     Foreground="#B45309" Margin="0,4,0,0"
                                     Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Button Content="打开所在文件夹" Margin="0,10,0,0" HorizontalAlignment="Left"
                      Padding="10,4"
                      Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <DataTemplate.Triggers>
        <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="RowRoot" Property="Background" Value="#F8FAFF" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部：标题 + 操作 -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/app.ico" Width="22" Height="22" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="RubbishCleaner" Style="{StaticResource TitleText}" Margin="8,0,0,0" />
          <TextBlock Text="v0.4.1" Style="{StaticResource SecondaryText}" Margin="8,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="开始扫描" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
          <Button Content="停止" Command="{Binding CancelCommand}" />
          <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" ToolTip="可用 Excel 打开筛选统计" />
          <Button Content="导出 HTML" Command="{Binding ExportHtmlCommand}" ToolTip="可直接查看或分享的报告" />
          <Button Content="打开日志" Command="{Binding OpenLogFolderCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 权限提示条 -->
    <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="0,0,0,1" Padding="16,8"
            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                   Text="当前以标准用户权限运行：HKLM、部分服务与计划任务可能读取不完整。建议以管理员身份重新启动。" />
        <Button Grid.Column="1" Content="以管理员身份重启" Command="{Binding RelaunchElevatedCommand}" />
      </Grid>
    </Border>

    <!-- 主体：两个页签 —— 启动项检测 / 已安装软件 -->
    <TabControl Grid.Row="2" x:Name="MainTabs" Background="Transparent" BorderThickness="0"
                Padding="0" Margin="0">

      <TabItem Header="启动项检测">
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

      <!-- 左侧分组与统计 -->
      <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="分类" FontWeight="SemiBold" Margin="0,0,0,8" />
          <Button Content="全部" HorizontalContentAlignment="Left" Command="{Binding ShowAllCommand}" />
          <Button Content="高风险" HorizontalContentAlignment="Left" Command="{Binding ShowHighRiskCommand}" />
          <Button Content="疑似" HorizontalContentAlignment="Left" Command="{Binding ShowSuspiciousCommand}" />
          <Button Content="正常" HorizontalContentAlignment="Left" Command="{Binding ShowNormalCommand}" />

          <Separator Margin="0,12" />

          <TextBlock Text="清理" FontWeight="SemiBold" Margin="0,0,0,8" />
          <Button HorizontalContentAlignment="Left" Command="{Binding ShowOrphanCommand}"
                  Content="{Binding OrphanFilterText}"
                  ToolTip="启动项指向的文件已不存在（卸载/升级残留），可以安全清理" />

          <Button HorizontalContentAlignment="Center" Margin="0,6,0,0"
                  Command="{Binding CleanOrphansCommand}"
                  Background="#FDECEC" BorderBrush="#E8B4B4" Foreground="#B42318"
                  ToolTip="先备份为 .reg 文件，再删除这些失效的注册表启动项（只删值，不删键）">
            <Button.ContentTemplate>
              <DataTemplate>
                <!-- 文案可能较长（如"可清理 0"），允许换行避免被截断 -->
                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" />
              </DataTemplate>
            </Button.ContentTemplate>
            <Button.Content>
              <Binding Path="CleanOrphansText" />
            </Button.Content>
          </Button>

          <Button HorizontalContentAlignment="Center" Margin="0,6,0,0"
                  Content="打开备份目录"
                  Command="{Binding OpenBackupFolderCommand}"
                  ToolTip="每次清理前都会自动备份，双击 .reg 文件即可还原" />

          <Separator Margin="0,12" />

          <TextBlock Text="统计" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="{Binding CountsText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DurationText, StringFormat=耗时：{0}}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding TrustTableInfo, StringFormat=特征库：{0}}" Style="{StaticResource SecondaryText}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- 右侧列表 -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!--
            表头（点击排序）。
            右侧留白由代码按 SystemParameters.VerticalScrollBarWidth 动态补齐，
            原因：ListBox 的垂直滚动条会占掉行内容宽度，表头若不留同样宽度就会整体错位。
            写死数值在不同 DPI / 主题下不准（实测 27px 仍有偏差）。
          -->
          <Border Grid.Row="0" x:Name="HeaderBorder" Background="#FAFBFC"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="8,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="28" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Style="{StaticResource HeaderButton}"
                      Command="{Binding SortCommand}" CommandParameter="{x:Static infra:SortColumn.Level}"
                      Content="{Binding LevelHeader}" ToolTip="按风险等级排序" />

              <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Margin="6,0,8,0"
                      Command="{Binding SortCommand}" CommandParameter="{x:Static infra:SortColumn.Name}"
                      Content="{Binding NameHeader}" ToolTip="按名称排序" />

              <Button Grid.Column="3" Style="{StaticResource HeaderButton}"
                      Command="{Binding SortCommand}" CommandParameter="{x:Static infra:SortColumn.StartupSource}"
                      Content="{Binding StartupHeader}" ToolTip="按启动方式排序" />

              <Button Grid.Column="4" Style="{StaticResource HeaderButton}"
                      Command="{Binding SortCommand}" CommandParameter="{x:Static infra:SortColumn.Publisher}"
                      Content="{Binding PublisherHeader}" ToolTip="按发行商排序" />

              <Button Grid.Column="5" Style="{StaticResource HeaderButton}"
                      Command="{Binding SortCommand}" CommandParameter="{x:Static infra:SortColumn.Score}"
                      Content="{Binding ScoreHeader}" ToolTip="按风险分排序" />

              <Button Grid.Column="6" Style="{StaticResource HeaderButton}"
                      Command="{Binding SortCommand}" CommandParameter="{x:Static infra:SortColumn.Trust}"
                      Content="{Binding TrustHeader}" ToolTip="按确认表判定排序" />
            </Grid>
          </Border>

          <!-- 列表：开启虚拟化与容器回收，十万级数据不卡 -->
          <ListBox Grid.Row="1"
                   x:Name="ProfileList"
                   ItemsSource="{Binding FilteredProfiles}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   ItemTemplate="{StaticResource SoftwareRowTemplate}"
                   BorderThickness="0"
                   Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel"
                   VirtualizingPanel.CacheLength="2">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>

          <!-- 空状态 -->
          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="还没有扫描结果" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="点击右上角「开始扫描」，检测开机自启动、无界面常驻程序" Margin="0,6,0,0"
                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

        </Grid>
      </TabItem>

      <TabItem Header="已安装软件">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 工具条 -->
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Content="刷新列表" Style="{StaticResource PrimaryButton}"
                      Command="{Binding Apps.RefreshCommand}" Margin="0,0,12,0" />

              <TextBox Grid.Column="1" x:Name="AppSearchBox" Margin="0,0,12,0" Padding="6,5"
                       VerticalContentAlignment="Center"
                       Text="{Binding Apps.FilterText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="按名称或发行商筛选" />

              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="{Binding Apps.SummaryText}" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- 软件列表 -->
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="8,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="软件" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="1" Text="版本" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="2" Text="发行商" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="3" Text="作用域" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="4" Text="架构" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="5" Text="大小" Style="{StaticResource SecondaryText}" />
                </Grid>
              </Border>

              <ListBox Grid.Row="1" ItemsSource="{Binding Apps.FilteredApps}"
                       SelectedItem="{Binding Apps.Selected, Mode=TwoWay}"
                       BorderThickness="0" Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       MouseDoubleClick="OnAppListDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" MinWidth="180" />
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="#FEF3C7" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                    Visibility="{Binding HasCorruptedText, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="文本异常" FontSize="10" Foreground="#92400E" />
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                    Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{Binding BlockReason}">
                              <TextBlock Text="卸载程序缺失" FontSize="10" Foreground="#991B1B" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding UninstallCommandText}" Style="{StaticResource SecondaryText}"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding UninstallCommandText}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Publisher}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding ScopeText}" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" />
                        <TextBlock Grid.Column="4" Text="{Binding ArchText}" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" />
                        <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding Apps.HasLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="还没有读取软件列表" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="点击左上角「刷新列表」读取本机已安装的软件" Margin="0,6,0,0"
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- 底部操作条 -->
          <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Apps.StatusText}" />
                <TextBlock Text="{Binding Apps.ErrorText}" Foreground="#B45309" FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{Binding Apps.ErrorText, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <Button Grid.Column="1" Content="卸载选中的软件"
                      Background="#FDECEC" BorderBrush="#E8B4B4" Foreground="#B42318"
                      Command="{Binding Apps.UninstallCommand}"
                      ToolTip="调用该软件自带的卸载程序；不会强制删除任何文件" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ============ v0.3 新增：残留扫描 ============ -->
      <TabItem Header="残留扫描">
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 左侧：操作与说明 -->
          <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <Button Content="扫描残留" Style="{StaticResource PrimaryButton}"
                      HorizontalContentAlignment="Center"
                      Command="{Binding Leftovers.ScanCommand}"
                      ToolTip="查找已卸载软件留下的目录（只读，不会改动任何文件）" />

              <Button HorizontalContentAlignment="Center" Margin="0,8,0,0"
                      Command="{Binding Leftovers.CleanCommand}"
                      Background="#FDECEC" BorderBrush="#E8B4B4" Foreground="#B42318"
                      ToolTip="只把目录移入回收站，随时可以还原；绝不永久删除">
                <Button.Content>
                  <Binding Path="Leftovers.CleanButtonText" />
                </Button.Content>
              </Button>

              <Separator Margin="0,12" />

              <!-- v0.4：注册表孤儿条目（与文件残留分开，判据完全不同） -->
              <TextBlock Text="注册表" FontWeight="SemiBold" Margin="0,0,0,6" />
              <Button Content="扫描注册表残留" HorizontalContentAlignment="Center"
                      Command="{Binding Leftovers.ScanRegistryCommand}"
                      ToolTip="查找「应用和功能」里点卸载会报错的孤儿条目（只读）" />

              <Button HorizontalContentAlignment="Center" Margin="0,6,0,0"
                      Command="{Binding Leftovers.CleanRegistryCommand}"
                      Background="#FDECEC" BorderBrush="#E8B4B4" Foreground="#B42318"
                      ToolTip="删除前自动导出 .reg 备份，双击即可还原">
                <Button.Content>
                  <Binding Path="Leftovers.RegistryButtonText" />
                </Button.Content>
              </Button>

              <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Text="仅清理 Windows Installer 已确认不存在的条目；有 .reg 备份可还原。" />

              <Separator Margin="0,12" />

              <TextBlock Text="筛选" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Button Content="全部残留" HorizontalContentAlignment="Left" Command="{Binding Leftovers.ShowAllCommand}" />
              <Button Content="只看可清理" HorizontalContentAlignment="Left" Command="{Binding Leftovers.ShowCleanableCommand}"
                      ToolTip="排除被安全闸门拦下的项（例如位于系统保护路径）" />

              <TextBox Margin="0,8,0,0" Padding="6,5" VerticalContentAlignment="Center"
                       Text="{Binding Leftovers.FilterText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="按路径或软件名筛选" />

              <Separator Margin="0,12" />

              <TextBlock Text="统计" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBlock Text="{Binding Leftovers.SummaryText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Leftovers.IndexText, StringFormat=索引：{0}}"
                         Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />

              <Border Background="#FFF8E1" BorderBrush="#F0D48A" BorderThickness="1" CornerRadius="4"
                      Padding="8" Margin="0,8,0,0"
                      Visibility="{Binding Leftovers.HasDegraded, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Leftovers.DegradedText}" TextWrapping="Wrap" FontSize="11" Foreground="#92400E" />
              </Border>

              <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Text="判定依据：目录里还留着卸载程序（unins000.exe / uninst.exe 等），或已被失效的启动项指向，且没有任何已安装软件认领它。" />
            </StackPanel>
          </Border>

          <!-- 右侧：残留列表 -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="110" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="8,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="置信度" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="1" Text="残留目录" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="3" Text="大小" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="4" Text="文件数" Style="{StaticResource SecondaryText}" />
                  <TextBlock Grid.Column="5" Text="最后修改" Style="{StaticResource SecondaryText}" />
                </Grid>
              </Border>

              <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

              <ListBox Grid.Row="0" ItemsSource="{Binding Leftovers.FilteredItems}"
                       SelectedItem="{Binding Leftovers.Selected, Mode=TwoWay}"
                       BorderThickness="0" Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                          </Grid.ColumnDefinitions>

                          <!-- 置信度色块：确信=红（该清理），较可能=黄，仅提示=灰 -->
                          <Border Grid.Column="0" VerticalAlignment="Center">
                            <Border.Style>
                              <Style TargetType="Border" BasedOn="{StaticResource RiskPill}">
                                <Setter Property="Background" Value="#9CA3AF" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Item.Confidence}" Value="High">
                                    <Setter Property="Background" Value="#D13A3A" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Item.Confidence}" Value="Medium">
                                    <Setter Property="Background" Value="#D89B00" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ConfidenceText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                          </Border>

                          <StackPanel Grid.Column="1" Margin="6,0,8,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <Border Background="#FEE2E2" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                      Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="{Binding BlockReason}">
                                <TextBlock Text="不可自动清理" FontSize="10" Foreground="#991B1B" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DirectoryPath}" Style="{StaticResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryPath}" />
                          </StackPanel>

                          <TextBlock Grid.Column="2" Text="{Binding KindText}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryText}" />
                          <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="4" Text="{Binding FileCountText}" VerticalAlignment="Center"
                                     Style="{StaticResource SecondaryText}" />
                          <TextBlock Grid.Column="5" Text="{Binding LastWriteText}" VerticalAlignment="Center"
                                     Style="{StaticResource SecondaryText}" />
                        </Grid>

                        <!-- 判定依据：让用户能自己复核"凭什么说它是残留" -->
                        <ItemsControl ItemsSource="{Binding Evidence}" Margin="88,4,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <!-- 用 Run 拼前缀而不是 StringFormat：StringFormat 里的 {0}
                                   会被 XAML 解析器当成标记扩展，报"找不到 Extension 程序集"（实测踩过） -->
                              <TextBlock FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         TextWrapping="Wrap">
                                <Run Text="· " /><Run Text="{Binding Mode=OneWay}" />
                              </TextBlock>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              </Grid>

              <!--
                v0.4：注册表残留区块。

                刻意做成独立的一段（自己的 Grid.Row + 自己的滚动条），而不是塞进文件残留那个 ListBox 里：
                两者是两类不同的东西（磁盘目录 vs「应用和功能」条目），处置方式也不同（移入回收站 vs 删键+备份），
                混在一个滚动区里用户会以为它们是一回事（v0.4.0 就是这样，收口时改掉）。
                三种空态各有各的话：没扫过 / 扫过且干净 / 筛掉了，不能共用一句"没有数据"。
              -->
              <Border Grid.Row="2" Background="#FFF8F8" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,1,0,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="72" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- 区块标题：语义化文案「注册表残留 N 条、可清理 M 条」由 VM 拼好，
                       避免在视图里拼中文量词（改文案时要动 XAML，容易两边不同步） -->
                  <!-- 这里只放标题与语义文案，不再复刻一个"扫描注册表残留"按钮：
                       同一个页面上两个同名按钮会让人犹豫该点哪个，入口统一留在左侧操作栏。 -->
                  <StackPanel Grid.Row="0" Margin="10,8,10,4">
                    <TextBlock Text="注册表残留（「应用和功能」里的孤儿条目）" FontWeight="SemiBold"
                               Foreground="#991B1B" />
                    <TextBlock Text="{Binding Leftovers.RegistrySummaryText}" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>

                  <!-- 表头：名称 / 版本 / 发行商 / 状态（状态是 MSI 的中文说明，用户复核的关键） -->
                  <Border Grid.Row="1" Background="#FDF1F1" BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="0,1,0,1" Padding="10,5"
                          Visibility="{Binding Leftovers.ShowRegistryList, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="210" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource SecondaryText}" />
                      <TextBlock Grid.Column="1" Text="版本" Style="{StaticResource SecondaryText}" />
                      <TextBlock Grid.Column="2" Text="发行商" Style="{StaticResource SecondaryText}" />
                      <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource SecondaryText}" />
                    </Grid>
                  </Border>

                  <!-- 条目列表：绑 FilteredRegistryItems，与文件残留共用同一套筛选条件 -->
                  <ListBox Grid.Row="2" ItemsSource="{Binding Leftovers.FilteredRegistryItems}"
                           SelectedItem="{Binding Leftovers.SelectedRegistry, Mode=TwoWay}"
                           BorderThickness="0" Background="Transparent" MaxHeight="150"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           Visibility="{Binding Leftovers.ShowRegistryList, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#F0D0D0" BorderThickness="0,0,0,1" Padding="10,5">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" MinWidth="150" />
                              <ColumnDefinition Width="90" />
                              <ColumnDefinition Width="130" />
                              <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                <Border Background="#FEE2E2" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding BlockReason}">
                                  <TextBlock Text="不可自动清理" FontSize="10" Foreground="#991B1B" />
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding ProductCode}" FontSize="11" Style="{StaticResource SecondaryText}"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Publisher}" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding StateText}" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StateText}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- 三种空态各说各的话 -->
                  <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,6"
                              Visibility="{Binding Leftovers.ShowRegistryEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="还没有检查注册表" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="点击「扫描注册表残留」：只读检查，不会改动注册表"
                               Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>

                  <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,6"
                              Visibility="{Binding Leftovers.ShowRegistryCleanState, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="注册表干净，没有孤儿条目" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Windows Installer 认识「应用和功能」里的每一个条目"
                               Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>

                  <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,6"
                              Visibility="{Binding Leftovers.ShowRegistryFilterEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="当前筛选条件下没有注册表条目" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="清空筛选关键词，或点「全部残留」看全部条目"
                               Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>

                  <!-- 选中行详情：完整键路径 + 被拦下的原因（注册表没有"打开所在文件夹"，用户只能靠这段文字复核） -->
                  <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="0,1,0,0" Padding="10,6"
                          Visibility="{Binding Leftovers.HasSelectedRegistry, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                      <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                        <Run Text="键路径：" /><Run Text="{Binding Leftovers.SelectedRegistry.FullPath, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" Margin="0,3,0,0"
                                 Visibility="{Binding Leftovers.SelectedRegistry.IsBlocked, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="不可自动清理的原因：" /><Run Text="{Binding Leftovers.SelectedRegistry.BlockReason, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0">
                        <Run Text="所在分支：" /><Run Text="{Binding Leftovers.SelectedRegistry.HiveText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding Leftovers.ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="还没有扫描残留" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="点击左上角「扫描残留」，查找已卸载软件留下的目录" Margin="0,6,0,0"
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
              </StackPanel>

              <!-- 底部状态条占最后一行：注册表区块插到了它上面，行号要跟着下移 -->
              <Border Grid.Row="3" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,1,0,0" Padding="10,8" CornerRadius="0,0,8,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Leftovers.StatusText}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Content="打开所在文件夹" Padding="10,3" Margin="8,0,0,0"
                          Command="{Binding Leftovers.OpenFolderCommand}"
                          CommandParameter="{Binding Leftovers.Selected}"
                          ToolTip="打开选中文件残留目录（注册表条目没有对应目录）" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- 底部状态栏 -->
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ProgressBar Grid.Column="0" Width="160" Height="6" Minimum="0" Maximum="100"
                     Value="{Binding Progress, Mode=OneWay}" Margin="0,0,12,0"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding StatusText}" />
          <TextBlock Text="{Binding StageText}" Style="{StaticResource SecondaryText}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding ErrorText}" Foreground="#B45309" TextWrapping="Wrap" FontSize="12"
                     Visibility="{Binding ErrorText, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>